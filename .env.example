# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SESSION_SECRET: Key used to sign login sessions. Must be the same on every server instance.
# If unset, a key is derived from GEMINI_API_KEY. Generate one with: openssl rand -hex 32
SESSION_SECRET="MY_SESSION_SECRET"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGODB_URI: MongoDB connection string. REQUIRED for real use (and on Vercel, where every serverless
# instance must share the same data). Without it the app keeps data in memory only (lost on restart).
# Local example: mongodb://127.0.0.1:27017/brickfour_compliance
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/brickfour_compliance
MONGODB_URI="mongodb://127.0.0.1:27017/brickfour_compliance"

# MONGODB_DB: Optional database name override (defaults to the database in MONGODB_URI, else "brickfour_compliance").
# MONGODB_DB="brickfour_compliance"
